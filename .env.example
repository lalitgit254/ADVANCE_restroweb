FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# Database
DATABASE_URL=mysql+pymysql://restaurant_user:restaurant_pass@localhost:3306/restaurant_db

# Redis (optional - for production caching/SocketIO scaling)
REDIS_URL=redis://localhost:6379/0

# Rate limiting storage (use memory:// for local dev without Redis)
RATELIMIT_STORAGE_URI=memory://

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMS (Twilio optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App Settings
APP_NAME=RestaurantPro
APP_URL=http://localhost:5000
BOOKING_ADVANCE_DAYS=30
LOYALTY_POINTS_PER_RUPEE=1
